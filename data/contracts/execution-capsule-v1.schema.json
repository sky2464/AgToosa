{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sky2464/AgToosa/contracts/execution-capsule-v1.schema.json",
  "title": "AgToosa Execution Capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "capsule_id",
    "story_id",
    "created_at",
    "ownership",
    "scope",
    "policy",
    "budgets",
    "verification",
    "return_contract"
  ],
  "properties": {
    "version": { "const": 1 },
    "capsule_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "story_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "created_at": { "type": "string" },
    "ownership": { "$ref": "#/$defs/ownership" },
    "scope": { "$ref": "#/$defs/scope" },
    "policy": { "$ref": "#/$defs/policy" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "verification": { "$ref": "#/$defs/verification" },
    "return_contract": { "$ref": "#/$defs/returnContract" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.).+$"
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "team": { "type": "string" },
        "exported_by": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/safePath" }
        },
        "forbidden_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/safePath" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "secrets"],
      "properties": {
        "network": { "enum": ["deny", "allow"] },
        "secrets": { "enum": ["forbid", "allow"] }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files_changed", "max_verification_commands"],
      "properties": {
        "max_files_changed": { "type": "integer", "minimum": 1 },
        "max_verification_commands": { "type": "integer", "minimum": 1 }
      }
    },
    "verificationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "expected_exit_code": { "type": "integer" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verificationCommand" }
        }
      }
    },
    "returnContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "required_fields"],
      "properties": {
        "schema": { "const": "capsule-return-v1" },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proof_graph_path": { "$ref": "#/$defs/safePath" },
        "drift_report_path": { "$ref": "#/$defs/safePath" },
        "handoff_path": { "$ref": "#/$defs/safePath" }
      }
    }
  }
}
