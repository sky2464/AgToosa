{
  "name": "agtoosa-hero",
  "private": true,
  "version": "1.0.0",
  "description": "Remotion marketing film and silent README loop for AgToosa",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:versions": "remotion versions",
    "generate:review-audio": "node scripts/generate-review-audio.mjs",
    "prepare:music": "node scripts/prepare-music.mjs",
    "render:storyboard": "node scripts/render.mjs storyboard",
    "render:animatic": "node scripts/render.mjs animatic",
    "render:readme": "node scripts/render.mjs readme",
    "render:poster": "node scripts/render.mjs poster",
    "render:master": "node scripts/render.mjs master",
    "render:checkpoint": "node scripts/render.mjs checkpoint",
    "check:audio": "node scripts/check-audio.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "verify:checkpoint": "node scripts/verify-media.mjs --checkpoint",
    "legacy:generate-audio": "node scripts/generate-audio.mjs",
    "legacy:render": "remotion render src/index.ts Hero out/legacy/agtoosa-hero.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "typescript": "^5.5.4"
  }
}
