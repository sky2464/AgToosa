# ──────────────────────────────────────────────────────────────
# AgToosa .gitignore
# ──────────────────────────────────────────────────────────────

# ── OS Files ─────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini
*~

# ── IDEs & Editors ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.code-workspace

# ── Local-only agent/editor state (never commit) ──────────────
.claude/
.codex/
.tmp/
.remember/

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env

# ── Environment & Secrets ────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Build artifacts ──────────────────────────────────────────
dist/
build/
*.egg-info/
_site/
docs/_site/
.jekyll-cache/
.sass-cache/

# ── Hero media Remotion project ──────────────────────────────
# Rendered assets (GIF/PNG/SVG) are hosted on GitHub Releases;
# the Remotion source stays local-only, never tracked in git.
docs/media/agtoosa-hero/

# ── AgToosa Generated Output ────────────────────────────────
ship/
.agtoosa/
# Operational install state (DEV-093) — covered by .agtoosa/ above; never commit.
# .agtoosa/state.json
# Project transaction journals (DEV-119) — covered by .agtoosa/ above; never commit.
# .agtoosa/transactions/
# MAJOR migration rollback manifests/backups (DEV-091) — .agtoosa/rollback/
# Template pack ships committed .agtoosa/ examples (DEV-087 config index).
!template/.agtoosa/
!template/.agtoosa/**
.worktrees/
