{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sky2464/AgToosa/contracts/interchange-loss-report-v1.schema.json",
  "title": "AgToosa Interchange Loss Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "story_id", "source_framework", "entries"],
  "properties": {
    "version": { "const": 1 },
    "story_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "source_framework": {
      "enum": ["speckit", "openspec", "bmad", "kiro", "agtoosa"]
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/lossEntry" }
    }
  },
  "$defs": {
    "lossEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason", "severity"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["low", "high"] }
      }
    }
  }
}
